<Project>
  <!--
    VSTO requires ClickOnce manifest signing even for local development.
    The repository does not commit a private PFX, so create a machine-local
    development certificate when the file is missing.
  -->
  <PropertyGroup>
    <LocalVstoCertificatePath>$(MSBuildProjectDirectory)\Properties\ExcelCSIToolBoxAddIn_TemporaryKey.pfx</LocalVstoCertificatePath>
    <SignManifests>true</SignManifests>
    <ManifestKeyFile>Properties\ExcelCSIToolBoxAddIn_TemporaryKey.pfx</ManifestKeyFile>
    <ManifestCertificateThumbprint />
  </PropertyGroup>

  <Target Name="EnsureLocalVstoSigningCertificate"
          BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(LocalVstoCertificatePath)')">
    <MakeDir Directories="$(MSBuildProjectDirectory)\Properties" />
    <Message Importance="high"
             Text="Creating a local VSTO development signing certificate at $(LocalVstoCertificatePath)" />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$cert = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=ExcelCSIToolBoxAddIn Development' -CertStoreLocation 'Cert:\CurrentUser\My' -KeyExportPolicy Exportable -HashAlgorithm SHA256 -NotAfter (Get-Date).AddYears(5); $password = New-Object System.Security.SecureString; Export-PfxCertificate -Cert $cert -FilePath '$(LocalVstoCertificatePath)' -Password $password -Force | Out-Null&quot;" />
    <Error Condition="!Exists('$(LocalVstoCertificatePath)')"
           Text="Failed to create the local VSTO signing certificate at $(LocalVstoCertificatePath)." />
  </Target>
</Project>
