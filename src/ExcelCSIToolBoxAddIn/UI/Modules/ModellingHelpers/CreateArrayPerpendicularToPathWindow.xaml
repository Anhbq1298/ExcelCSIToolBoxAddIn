<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.CreateArrayPerpendicularToPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Array Perpendicular To Path"
        Width="880"
        Height="470"
        MinWidth="760"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontFamily.Primary}"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ExcelCSIToolBoxAddIn;component/UI/Shared/Themes/EtabsToolboxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Inset.Medium}">
        <Border Style="{StaticResource CardBorderStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
            <Grid MinWidth="660">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="2.3*"
                                      MinWidth="150"/>
                    <ColumnDefinition Width="0.9*"
                                      MinWidth="72"/>
                    <ColumnDefinition Width="0.9*"
                                      MinWidth="72"/>
                    <ColumnDefinition Width="0.9*"
                                      MinWidth="72"/>
                    <ColumnDefinition Width="1.1*"
                                      MinWidth="86"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="8"
                           Text="Create Array Perpendicular To Path"
                           Style="{StaticResource HeadingTextStyle}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Point 1"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding Point1Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Point Unique Name"/>
                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="X: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point1X}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Y: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point1Y}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Z: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point1Z}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <Button Grid.Row="2"
                        Grid.Column="7"
                        Content="Pick"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding PickPoint1Command}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Point 2"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding Point2Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Point Unique Name"/>
                <StackPanel Grid.Row="4"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="X: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point2X}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="4"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Y: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point2Y}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="4"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Z: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding Point2Z}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <Button Grid.Row="4"
                        Grid.Column="7"
                        Content="Pick"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding PickPoint2Command}"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Reference Frame"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Text="{Binding ReferenceFrameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Frame Unique Name"/>
                <StackPanel Grid.Row="6"
                            Grid.Column="4"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="Length: " Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="{Binding ReferenceFrameLength}" Style="{StaticResource LabelTextStyle}"/>
                </StackPanel>
                <Button Grid.Row="6"
                        Grid.Column="7"
                        Content="Pick"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding PickReferenceFrameCommand}"/>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Assign Section"
                           Style="{StaticResource LabelTextStyle}"/>
                <ComboBox Grid.Row="8"
                          Grid.Column="1"
                          Grid.ColumnSpan="7"
                          ItemsSource="{Binding AvailableSections}"
                          SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                          Height="26"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Text="End Fixity"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Top"/>
                <StackPanel Grid.Row="10"
                            Grid.Column="1"
                            Grid.ColumnSpan="7">
                    <RadioButton Content="Fix-Fix"
                                 GroupName="EndFixity"
                                 IsChecked="{Binding IsFixFixSelected, Mode=TwoWay}"/>
                    <RadioButton Content="Pin-Pin"
                                 GroupName="EndFixity"
                                 Margin="0,5,0,0"
                                 IsChecked="{Binding IsPinPinSelected, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Row="12"
                           Grid.Column="0"
                           Text="Auto Trim / Extend"
                           Style="{StaticResource LabelTextStyle}"/>
                <CheckBox Grid.Row="12"
                          Grid.Column="1"
                          Grid.ColumnSpan="7"
                          Content="Auto Trim / Extend To Existing Elements"
                          IsChecked="{Binding IsAutoTrimExtendEnabled, Mode=TwoWay}"/>

                <TextBlock Grid.Row="14"
                           Grid.Column="0"
                           Text="Adjustment Mode"
                           Style="{StaticResource LabelTextStyle}"/>
                <ComboBox Grid.Row="14"
                          Grid.Column="1"
                          Grid.ColumnSpan="7"
                          ItemsSource="{Binding AdjustmentModes}"
                          SelectedItem="{Binding SelectedAdjustmentMode, Mode=TwoWay}"
                          Height="26"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="16"
                           Grid.Column="0"
                           Text="Number of Spaces"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="16"
                         Grid.Column="1"
                         Width="70"
                         HorizontalAlignment="Left"
                         Text="{Binding NumberOfSpaces, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         HorizontalContentAlignment="Right"/>

                <StackPanel Grid.Row="18"
                            Grid.Column="0"
                            Grid.ColumnSpan="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Create Frames"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110"
                            Margin="{StaticResource Gap.Right}"
                            Command="{Binding CreateFramesCommand}"/>
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Command="{Binding CloseWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
