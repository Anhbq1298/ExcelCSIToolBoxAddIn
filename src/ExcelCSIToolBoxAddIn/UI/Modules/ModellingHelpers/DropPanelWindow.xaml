<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.DropPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Column Drop Tool"
        Width="580"
        Height="620"
        MinWidth="520"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        FontFamily="{DynamicResource FontFamily.Primary}"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ExcelCSIToolBoxAddIn;component/UI/Shared/Themes/EtabsToolboxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Inset.Medium}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: Title -->
                    <RowDefinition Height="6"/>    <!-- 1: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 2: Description -->
                    <RowDefinition Height="10"/>   <!-- 3: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 4: Section Column Selection -->
                    <RowDefinition Height="6"/>    <!-- 5: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 6: Selection Controls -->
                    <RowDefinition Height="6"/>    <!-- 7: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 8: ListBox -->
                    <RowDefinition Height="10"/>   <!-- 9: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 10: Section Drop Parameters -->
                    <RowDefinition Height="6"/>    <!-- 11: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 12: Parameters Grid -->
                    <RowDefinition Height="10"/>   <!-- 13: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 14: Section Orientation -->
                    <RowDefinition Height="6"/>    <!-- 15: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 16: Orientation Grid -->
                    <RowDefinition Height="10"/>   <!-- 17: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 18: Feedback -->
                    <RowDefinition Height="10"/>   <!-- 19: Spacing -->
                    <RowDefinition Height="Auto"/> <!-- 20: Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Window Title -->
                <TextBlock Grid.Row="0"
                           Text="Column Drop Tool"
                           Style="{StaticResource HeadingTextStyle}"/>

                <!-- Description -->
                <TextBlock Grid.Row="2"
                           Text="Create column drops by splitting the connected slab shells at each selected column."
                           Style="{StaticResource MutedTextStyle}"
                           TextWrapping="Wrap"/>

                <!-- ── Column Selection ────────────────────────────────── -->
                <TextBlock Grid.Row="4"
                           Text="Column Selection"
                           Style="{StaticResource SectionHeadingTextStyle}"/>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Select Columns"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="120"
                            Command="{Binding SelectColumnsCommand}"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding SelectedColumnCountText}"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="8"
                        BorderBrush="{StaticResource BorderBrush.Light}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="{StaticResource PanelBackgroundBrush}"
                        Height="70">
                    <ListBox ItemsSource="{Binding SelectedColumns}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="6,4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FrameName}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ── Drop Parameters ────────────────────────────────── -->
                <TextBlock Grid.Row="10"
                           Text="Drop Parameters"
                           Style="{StaticResource SectionHeadingTextStyle}"/>

                <Grid Grid.Row="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <!-- Unit System -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Unit System"
                               Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                              ItemsSource="{Binding UnitSystems}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedUnitSystem, Mode=TwoWay}"
                              Height="26"
                              VerticalContentAlignment="Center"/>

                    <!-- Drop Thickness -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Drop Thickness"
                               Style="{StaticResource LabelTextStyle}"/>
                    <TextBox x:Name="DropThicknessTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Text="{Binding DropThicknessText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Text="{Binding SelectedUnitSystem.LengthUnitText}"
                               Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center"/>

                    <!-- Drop Width -->
                    <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Drop Width"
                               Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding DropWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="4" Grid.Column="3"
                               Text="{Binding SelectedUnitSystem.LengthUnitText}"
                               Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center"/>

                    <!-- Drop Length -->
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="Drop Length"
                               Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             Text="{Binding DropLengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="6" Grid.Column="3"
                               Text="{Binding SelectedUnitSystem.LengthUnitText}"
                               Style="{StaticResource BodyTextStyle}"
                               VerticalAlignment="Center"/>

                    <!-- Material -->
                    <TextBlock Grid.Row="8" Grid.Column="0"
                               Text="Material"
                               Style="{StaticResource LabelTextStyle}"/>
                    <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                              ItemsSource="{Binding ConcreteMaterials}"
                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              Height="26"
                              VerticalContentAlignment="Center"/>

                    <!-- Property Name -->
                    <TextBlock Grid.Row="10" Grid.Column="0"
                               Text="Property Name"
                               Style="{StaticResource LabelTextStyle}"/>
                    <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3"
                             Text="{Binding PropertyNamePreview, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             Background="{StaticResource PanelBackgroundBrush}"/>
                </Grid>

                <!-- ── Orientation ─────────────────────────────────────── -->
                <TextBlock Grid.Row="14"
                           Text="Orientation"
                           Style="{StaticResource SectionHeadingTextStyle}"/>

                <Grid Grid.Row="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                Orientation="Horizontal">
                        <RadioButton Content="Align with Column Axes"
                                     GroupName="DropOrientation"
                                     IsChecked="{Binding IsAlignWithColumnAxes, Mode=TwoWay}"
                                     FontFamily="{DynamicResource FontFamily.Primary}"
                                     FontSize="{DynamicResource FontSize.Body}"
                                     Foreground="{DynamicResource TextBrush.Primary}"/>
                        <RadioButton Content="Specified Rotation"
                                     GroupName="DropOrientation"
                                     Margin="24,0,0,0"
                                     IsChecked="{Binding IsSpecifiedRotation, Mode=TwoWay}"
                                     FontFamily="{DynamicResource FontFamily.Primary}"
                                     FontSize="{DynamicResource FontSize.Body}"
                                     Foreground="{DynamicResource TextBrush.Primary}"/>
                    </StackPanel>

                    <!-- Rotation Angle -->
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Rotation Angle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpecifiedRotation}" Value="False">
                                        <Setter Property="Foreground" Value="#98A2B3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             IsEnabled="{Binding IsSpecifiedRotation}"
                             Text="{Binding RotationAngleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Right"/>
                    <TextBlock Grid.Row="2" Grid.Column="3"
                               Text="deg">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpecifiedRotation}" Value="False">
                                        <Setter Property="Foreground" Value="#98A2B3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- ── Feedback ────────────────────────────────────────── -->
                <StackPanel Grid.Row="18">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ── Action buttons ──────────────────────────────────── -->
                <Grid Grid.Row="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Export Log"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="92"
                            HorizontalAlignment="Left"
                            Command="{Binding ExportLogCommand}"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Create Drop"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="110"
                                Margin="{StaticResource Gap.Right}"
                                Command="{Binding ApplyCommand}"/>
                        <Button Content="Close"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="76"
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
