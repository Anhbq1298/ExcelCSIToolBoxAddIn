<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.CreateSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Section From Excel"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F6FA"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="#1F2937">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ExcelCSIToolBoxAddIn;component/UI/Themes/EtabsToolboxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F3F6FA"/>
            <SolidColorBrush x:Key="DialogCardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DialogHeaderBrush" Color="#102A4C"/>
            <SolidColorBrush x:Key="DialogAccentBrush" Color="#2F80ED"/>
            <SolidColorBrush x:Key="DialogButtonHoverBrush" Color="#EEF7FF"/>

            <Style x:Key="DialogSectionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="ShapeSelectButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#102033"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CAD8E6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource DialogButtonHoverBrush}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#D8ECFF"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E5E7EB"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D1D5DB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource DialogBackgroundBrush}"
          SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DialogHeaderBrush}"
                Padding="22,16,22,15">
            <StackPanel>
                <TextBlock Text="Create Section"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="From Excel range"
                           FontSize="11"
                           Foreground="#D7E3F0"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="18,18,18,14"
                Padding="16"
                Background="{StaticResource DialogCardBrush}"
                BorderBrush="#DCE6EF"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Steel sections"
                           Style="{StaticResource DialogSectionTextStyle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="I-Shape" Style="{StaticResource ShapeSelectButtonStyle}" Click="IshapeButton_Click"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Channel" Style="{StaticResource ShapeSelectButtonStyle}" Click="ChannelButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="0" Content="Angle" Style="{StaticResource ShapeSelectButtonStyle}" Click="AngleButton_Click"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Tube" Style="{StaticResource ShapeSelectButtonStyle}" Click="TubeButton_Click"/>
                    <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="Pipe" Style="{StaticResource ShapeSelectButtonStyle}" Click="PipeButton_Click"/>
                </Grid>

                <TextBlock Grid.Row="3"
                           Text="Concrete sections"
                           Style="{StaticResource DialogSectionTextStyle}"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Rectangle" Style="{StaticResource ShapeSelectButtonStyle}" Click="RectangleButton_Click"/>
                    <Button Grid.Column="2" Content="Circle" Style="{StaticResource ShapeSelectButtonStyle}" Click="CircleButton_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="18,0,18,18">
            <Button Content="Cancel"
                    Width="82"
                    Height="30"
                    HorizontalAlignment="Right"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
