<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.OutputTableExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle, FallbackValue=Export ETABS Table}"
        Height="560"
        Width="820"
        MinHeight="460"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="{Binding CaseComboSelectorRowHeight}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding ReportTypeText}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{Binding InstructionText}"
                       TextWrapping="Wrap"
                       FontStyle="Italic"
                       Foreground="#334155"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Visibility="{Binding UnitSelectorVisibility}"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Output units:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding UnitOptions}"
                      SelectedItem="{Binding SelectedUnitOption, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      Height="26"
                      VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding ForceUnitText}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBlock Grid.Column="5"
                       Text="{Binding MomentUnitText}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Grid>

        <GroupBox Grid.Row="2"
                  Header="Output Cases / Combinations"
                  Visibility="{Binding CaseComboSelectorVisibility}"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Content="Load Cases/Combos"
                            Command="{Binding LoadOutputCasesCommand}"
                            MinWidth="130"/>
                    <TextBlock Text="{Binding OutputCaseSelectorHelpText}"
                               VerticalAlignment="Center"
                               Foreground="#444444"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding LoadCombinationSpacerWidth}"/>
                        <ColumnDefinition Width="{Binding LoadCombinationColumnWidth}"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="{Binding CaseSelectorTitle}"
                              Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="LoadCasesGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding LoadCases}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      BorderBrush="#CCCCCC"
                                      BorderThickness="1"
                                      SelectionChanged="OutputCaseGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding LoadCaseSelectionText}"
                                       Foreground="#666666"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2"
                              Header="Load Combinations"
                              Visibility="{Binding LoadCombinationSelectorVisibility}"
                              Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="LoadCombinationsGrid"
                                      Grid.Row="0"
                                      ItemsSource="{Binding LoadCombinations}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      BorderBrush="#CCCCCC"
                                      BorderThickness="1"
                                      SelectionChanged="OutputCaseGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding LoadCombinationSelectionText}"
                                       Foreground="#666666"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="Excel Anchor Cell"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <RadioButton Content="Use active cell"
                                 IsChecked="{Binding IsUseActiveCellMode, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <RadioButton Content="Pick cell"
                                 IsChecked="{Binding IsPickCellMode, Mode=TwoWay}"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Anchor:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding AnchorCellAddress, Mode=OneWay}"
                         IsReadOnly="True"
                         Height="26"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding AnchorModeText}"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <CheckBox Content="Add headers"
                          IsChecked="{Binding AddHeaders, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
                <Button Content="Export Report"
                        Click="RunButton_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
