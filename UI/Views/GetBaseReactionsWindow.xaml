<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.GetBaseReactionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Base Reactions"
        Height="520"
        Width="720"
        MinHeight="460"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select ETABS load cases / combinations to extract Base Reactions, then select the Excel anchor cell where the first data row should start. Headers are excluded."
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                BorderBrush="#D5DCE3"
                BorderThickness="1"
                Background="#F8FAFC"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Select the ETABS load cases / load combinations of interest first." TextWrapping="Wrap"/>
                <TextBlock Text="Select the Excel anchor cell where the result data should start." TextWrapping="Wrap"/>
                <TextBlock Text="The selected anchor cell is the first data row only, excluding headers." TextWrapping="Wrap"/>
                <TextBlock Text="Example: if the header row is already in row 3, user selects A4." TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2"
                  Header="ETABS Output Cases"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Content="Load Cases/Combos"
                            Command="{Binding LoadOutputCasesCommand}"
                            MinWidth="130"/>
                    <TextBlock Text="Choose one or more cases/combinations."
                               VerticalAlignment="Center"
                               Foreground="#444444"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding OutputCases}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Extended"
                          BorderBrush="#CCCCCC"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header=""
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="42"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="Excel Anchor Cell"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Anchor:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding AnchorCellAddress, Mode=OneWay}"
                         IsReadOnly="True"
                         Height="26"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Use Active Cell"
                        Command="{Binding UseActiveCellCommand}"
                        MinWidth="112"/>

                <Button Grid.Column="3"
                        Content="Pick Cell"
                        Command="{Binding PickAnchorCellCommand}"
                        MinWidth="86"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Foreground="#555555"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Run"
                        Command="{Binding RunCommand}"
                        IsDefault="True"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
