<UserControl x:Class="ExcelCSIToolBoxAddIn.UI.Views.EtabsToolboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ExcelCSIToolBoxAddIn.UI.Views"
             mc:Ignorable="d"
             FontFamily="{DynamicResource FontFamily.Primary}"
             FontSize="{DynamicResource FontSize.Body}"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ExcelCSIToolBoxAddIn;component/UI/Themes/EtabsToolboxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:TableHeaderToolTipConverter x:Key="TableHeaderToolTipConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Inset.Medium}"
          Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="10,8"
                Margin="{StaticResource Gap.Section}"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource HeaderBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Text="{Binding ProductTitle, FallbackValue=ETABS Toolbox}"
                           FontSize="{StaticResource FontSize.WindowTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush.Inverse}"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="2"
                        Grid.Row="0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource StatusBrush.AttachedBackground}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusBrush.Attached}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusBrush.NotAttached}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusBrush.Attached}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
                                    <Setter Property="Text" Value="Not attached"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="Attached"/>
                                            <Setter Property="Foreground" Value="{StaticResource StatusBrush.Attached}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4"
                            Grid.Row="0"
                            VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Refresh running instances"
                                Margin="6,0,0,0"
                                Command="{Binding RefreshRunningCsiInstancesCommand}">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                        <ComboBox ItemsSource="{Binding RunningCsiInstances}"
                                  SelectedItem="{Binding SelectedRunningCsiInstance, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="{Binding SelectedRunningCsiInstance.ToolTipText}"
                                  MinWidth="220"
                                  MaxWidth="360"
                                  Height="26"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding CurrentModelUnitText}"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{StaticResource TextBrush.NavyMuted}"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,8,0,0">
                    <TextBlock Text="Unit System:"
                               Style="{StaticResource MutedTextStyle}"
                               Foreground="{StaticResource TextBrush.NavyMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding AvailableUnitSystems}"
                              SelectedItem="{Binding SelectedUnitSystem, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Width="92"
                              Height="28"
                              VerticalContentAlignment="Center"/>
                    <Button Content="{Binding ModelLockButtonText}"
                            Style="{StaticResource PillButtonStyle}"
                            Margin="14,0,8,0"
                            Command="{Binding ToggleModelLockCommand}"/>
                    <Button Content="Attach"
                            Style="{StaticResource PillButtonStyle}"
                            Margin="{StaticResource Gap.Right}"
                            Command="{Binding AttachToRunningCsiCommand}"/>
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="{StaticResource Gap.Right}"
                            Command="{Binding CloseCurrentInstanceCommand}"/>
                    <Button Content="?"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Help"
                            Click="HelpButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush.Light}"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <TextBlock Text="Project Manager"
                                   Style="{StaticResource SectionHeadingTextStyle}"/>
                    </Border>

                    <TreeView x:Name="ProjectManagerTree"
                              ItemContainerStyle="{StaticResource ProjectManagerTreeStyle}"
                              SelectedItemChanged="ProjectManagerTree_SelectedItemChanged"
                              BorderThickness="0"
                              Background="{StaticResource CardBackgroundBrush}"
                              Padding="3,6,2,6">
                        <TreeViewItem Header="ETABS Toolbox" IsExpanded="True" FontWeight="Bold">
                            <TreeViewItem Header="Model" IsExpanded="True" FontWeight="Normal">
                                <TreeViewItem Header="General Information" IsExpanded="True" FontWeight="Normal">
                                    <TreeViewItem Header="Section Property" Tag="0" FontWeight="Normal"/>
                                    <TreeViewItem Header="Section Property - Stiffness Modifier" Tag="7" FontWeight="Normal"/>
                                    <TreeViewItem Header="Load Pattern" Tag="4" FontWeight="Normal"/>
                                    <TreeViewItem Header="Load Combination" Tag="5" FontWeight="Normal"/>
                                </TreeViewItem>
                                <TreeViewItem Header="Element Manipulation" IsExpanded="True" FontWeight="Normal">
                                    <TreeViewItem Header="Point" Tag="1" FontWeight="Normal"/>
                                    <TreeViewItem Header="Frame" Tag="2" FontWeight="Normal"/>
                                    <TreeViewItem Header="Shell" Tag="3" FontWeight="Normal"/>
                                    <TreeViewItem Header="Etabs Object Connectivity"
                                                  Tag="Tables:Element Manipulation:Etabs Object Connectivity"
                                                  IsExpanded="True"
                                                  FontWeight="Normal"/>
                                </TreeViewItem>
                                <TreeViewItem Header="ANALYSIS RESULTS" IsExpanded="True" FontWeight="Normal">
                                     <TreeViewItem Header="Joint Output" Tag="Results:Joint Output" IsExpanded="True" FontWeight="Normal">
                                         <TreeViewItem Header="Displacements" Tag="Results:Displacements" FontWeight="Normal"/>
                                         <TreeViewItem Header="Reactions" Tag="Results:Reactions" FontWeight="Normal"/>
                                         <TreeViewItem Header="Velocity and Acceleration" Tag="Results:Velocity and Acceleration" FontWeight="Normal"/>
                                         <TreeViewItem Header="Joint Masses" Tag="Results:Assembled Joint Masses" FontWeight="Normal"/>
                                     </TreeViewItem>
                                     <TreeViewItem Header="Element Output" IsExpanded="True" FontWeight="Normal">
                                         <TreeViewItem Header="Frame Output" Tag="Results:Frame Output" FontWeight="Normal"/>
                                         <TreeViewItem Header="Area Output" Tag="Results:Area Output" FontWeight="Normal"/>
                                         <TreeViewItem Header="Wall Output" Tag="Results:Wall Output" FontWeight="Normal"/>
                                         <TreeViewItem Header="Objects and Elements" Tag="Results:Objects and Elements" FontWeight="Normal"/>
                                     </TreeViewItem>
                                    <TreeViewItem Header="Structure Output" IsExpanded="True" FontWeight="Normal">
                                        <TreeViewItem Header="Base Reactions" Tag="Results:Base Reactions" FontWeight="Normal"/>
                                        <TreeViewItem Header="Modal Information" Tag="Results:Modal Information" FontWeight="Normal"/>
                                        <TreeViewItem Header="Mass Data" Tag="Results:Mass Data" FontWeight="Normal"/>
                                        <TreeViewItem Header="Other Output Items" Tag="Results:Other Output Items" FontWeight="Normal"/>
                                    </TreeViewItem>
                                </TreeViewItem>
                                 <TreeViewItem Header="MISCELLANEOUS DATA" IsExpanded="True" FontWeight="Normal">
                                     <TreeViewItem Header="Project Information" Tag="Tables:MISCELLANEOUS DATA:Project Information" FontWeight="Normal"/>
                                     <TreeViewItem Header="Material List" Tag="Tables:MISCELLANEOUS DATA:Material List" FontWeight="Normal"/>
                                 </TreeViewItem>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CompactCardBorderStyle}"
                        Padding="10,7">
                    <StackPanel>
                        <TextBlock Text="{Binding ActivePageTitle}"
                                   Style="{StaticResource HeadingTextStyle}"/>
                        <TextBlock Text="{Binding ActivePageBreadcrumb}"
                                   Style="{StaticResource BreadcrumbTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="{StaticResource Inset.Small}">
                    <TabControl x:Name="WorkspaceTabs"
                                Style="{StaticResource WorkspaceContentTabControlStyle}"
                                SelectedIndex="{Binding ActiveWorkspacePage, Mode=TwoWay}">
                        <TabItem Header="Section Property">
                            <Grid Margin="{StaticResource Inset.Small}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.35*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0"
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        Style="{StaticResource CompactCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Create From Excel Range"
                                                   Style="{StaticResource SectionHeadingTextStyle}"
                                                   Margin="{StaticResource Gap.Card}"/>
                                        <Button Content="Ishape" Margin="{StaticResource Gap.Card}" Command="{Binding CreateIshapeSectionCommand}"/>
                                        <Button Content="Channel" Margin="{StaticResource Gap.Card}" Command="{Binding CreateChannelSectionCommand}"/>
                                        <Button Content="Angle" Margin="{StaticResource Gap.Card}" Command="{Binding CreateAngleSectionCommand}"/>
                                        <Button Content="Tube" Margin="{StaticResource Gap.Card}" Command="{Binding CreateTubeSectionCommand}"/>
                                        <Button Content="Pipe" Margin="{StaticResource Gap.Card}" Command="{Binding CreatePipeSectionCommand}"/>
                                        <Button Content="Rectangle" Margin="{StaticResource Gap.Card}" Command="{Binding CreateConcreteRectangleSectionCommand}"/>
                                        <Button Content="Circle" Command="{Binding CreateConcreteCircleSectionCommand}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        Style="{StaticResource CompactCardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Section Preview"
                                                   Style="{StaticResource SectionHeadingTextStyle}"
                                                   Margin="{StaticResource Gap.Card}"/>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.4*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="0.6*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Section Information (40% width) -->
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource SectionPanelBorderStyle}"
                                                    VerticalAlignment="Stretch">
                                                <StackPanel>
                                                    <TextBlock Text="Section Information"
                                                               Style="{StaticResource SectionHeadingTextStyle}"
                                                               Margin="{StaticResource Gap.Row}"/>

                                                    <Grid Margin="{StaticResource Gap.Row}">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="0.38*"/>
                                                             <ColumnDefinition Width="0.62*"/>
                                                         </Grid.ColumnDefinitions>
                                                         <TextBlock Grid.Column="0"
                                                                    Text="Section Name"
                                                                    Style="{StaticResource LabelTextStyle}"
                                                                    FontWeight="SemiBold"/>
                                                         <TextBlock Grid.Column="1"
                                                                    x:Name="EtabsSectionNameLabel"
                                                                    Text="-"
                                                                    Style="{StaticResource LabelTextStyle}"
                                                                    FontWeight="SemiBold"/>
                                                     </Grid>
                                                     <Grid Margin="{StaticResource Gap.Row}">
                                                         <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="0.38*"/>
                                                             <ColumnDefinition Width="0.62*"/>
                                                         </Grid.ColumnDefinitions>
                                                         <TextBlock Grid.Column="0"
                                                                    Text="Shape Type"
                                                                    Style="{StaticResource MutedTextStyle}"/>
                                                         <TextBlock Grid.Column="1"
                                                                    x:Name="EtabsSectionTypeLabel"
                                                                    Text=""
                                                                    Style="{StaticResource MutedTextStyle}"/>
                                                     </Grid>

                                                     <Border Height="1"
                                                             Background="{StaticResource BorderBrush.Light}"
                                                             Margin="0,4,0,8"/>

                                                    <Grid Margin="{StaticResource Gap.Row}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.38*"/>
                                                            <ColumnDefinition Width="0.62*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Abbreviation"
                                                                   Style="{StaticResource MutedTextStyle}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Meaning"
                                                                   Style="{StaticResource MutedTextStyle}"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding SectionDimensionAnnotations}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="{StaticResource Gap.Row}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.38*"/>
                                                                        <ColumnDefinition Width="0.62*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding DisplayText}"
                                                                               Style="{StaticResource LabelTextStyle}"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding DescriptionText}"
                                                                               Style="{StaticResource MutedTextStyle}"
                                                                               TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Preview Canvas / Grid View (60% width) -->
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource PreviewPanelBorderStyle}"
                                                    VerticalAlignment="Stretch">
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas x:Name="EtabsSectionPreviewCanvas"
                                                            Width="100"
                                                            Height="100"/>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource CompactCardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Text="Existing Sections"
                                                   Style="{StaticResource SectionHeadingTextStyle}"
                                                   Margin="{StaticResource Gap.Card}"/>
                                        <DataGrid x:Name="FrameSectionList"
                                                  Grid.Row="1"
                                                  ItemsSource="{Binding FrameSections}"
                                                  SelectedItem="{Binding SelectedFrameSection}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True">
                                            <DataGrid.InputBindings>
                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                              Command="{Binding EditFrameSectionCommand}"
                                                              CommandParameter="{Binding ElementName=FrameSectionList, Path=SelectedItem}"/>
                                            </DataGrid.InputBindings>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding ShapeType}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="2"
                                                Content="Refresh List"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Command="{Binding GetFrameSectionsCommand}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Point">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <Border Style="{StaticResource CompactCardBorderStyle}"
                                        Margin="{StaticResource Inset.Small}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Select Point in Model from Excel Range" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="By UniqueName" Command="{Binding SelectPointsByUniqueNameCommand}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Add Point From Range Excel" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="By Cartesian" Command="{Binding AddPointByCartesianCommand}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Extract Selected Point Information" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="Run" Command="{Binding GetSelectedPointsCommand}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Grouping" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="6" Grid.Column="2" Content="Get" Command="{Binding GetPointGroupAssignmentCommand}"/>
                                        <Button Grid.Row="6" Grid.Column="4" Content="Set" Command="{Binding SetPointGroupAssignmentCommand}"/>
                                    </Grid>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Frame">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <Border Style="{StaticResource CompactCardBorderStyle}"
                                        Margin="{StaticResource Inset.Small}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Get Current Selection Frame UniqueNames" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Run" Command="{Binding GetSelectedFramesCommand}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Select Frame in Model from Excel Range" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="By UniqueName" Command="{Binding SelectFramesByUniqueNameCommand}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Add Frame From Range Excel" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="By Coor" Command="{Binding AddFramesByCoordinatesCommand}"/>
                                        <Button Grid.Row="4" Grid.Column="4" Content="By Point" Command="{Binding AddFramesByPointNamesCommand}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Extract Selected Frame Information" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="6" Grid.Column="2" Content="Run" Command="{Binding GetSelectedFramesCommand}"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Change Name" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="8" Grid.Column="2" Content="Run" Command="{Binding RenameFramesCommand}"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Frame Section Property" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="10" Grid.Column="2" Content="Get" Command="{Binding GetFrameSectionPropertyCommand}"/>
                                        <Button Grid.Row="10" Grid.Column="4" Content="Set" Command="{Binding SetFrameSectionPropertyCommand}"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Frame Group Assignment" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="12" Grid.Column="2" Content="Get" Command="{Binding GetFrameGroupAssignmentCommand}"/>
                                        <Button Grid.Row="12" Grid.Column="4" Content="Set" Command="{Binding SetFrameGroupAssignmentCommand}"/>

                                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Frame Modifier" Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Row="14" Grid.Column="2" Content="Get" Command="{Binding GetFrameModifierCommand}"/>
                                        <Button Grid.Row="14" Grid.Column="4" Content="Set" Command="{Binding SetFrameModifierCommand}"/>
                                    </Grid>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Shell">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <Border Style="{StaticResource CompactCardBorderStyle}"
                                        Margin="{StaticResource Inset.Small}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Create Shell Area From Selected Frames"
                                                   Style="{StaticResource LabelTextStyle}"/>
                                        <Button Grid.Column="2"
                                                Content="Create Shell"
                                                Command="{Binding CreateShellAreasFromSelectedFramesCommand}"/>
                                    </Grid>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="LoadPattern">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <Border Style="{StaticResource CompactCardBorderStyle}"
                                        Margin="{StaticResource Inset.Small}">
                                    <Grid MinHeight="210">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Existing Patterns in Model"
                                                   Style="{StaticResource SectionHeadingTextStyle}"
                                                   Margin="{StaticResource Gap.Card}"/>
                                        <DataGrid x:Name="LoadPatternList"
                                                  Grid.Row="1"
                                                  Grid.Column="0"
                                                  ItemsSource="{Binding LoadPatterns}"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding PlacementTarget.DataContext.DeleteSelectedLoadPatternsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Load Pattern Name" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Top">
                                            <Button Content="Refresh List"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="{StaticResource Gap.Card}"
                                                    Command="{Binding GetLoadPatternsCommand}"/>
                                            <Button Content="Add From Excel"
                                                    Command="{Binding AddLoadPatternFromExcelCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="LoadCombination">
                            <Border Style="{StaticResource CompactCardBorderStyle}"
                                    Margin="{StaticResource Inset.Small}">
                                <Grid MinHeight="320">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Existing Combinations in Model"
                                               Style="{StaticResource SectionHeadingTextStyle}"
                                               Margin="{StaticResource Gap.Card}"/>
                                    <DataGrid x:Name="LoadCombinationList"
                                              Grid.Row="1"
                                              Grid.Column="0"
                                              ItemsSource="{Binding LoadCombinations}"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              IsReadOnly="True">
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="View"
                                                          Command="{Binding PlacementTarget.DataContext.ViewLoadCombinationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Delete"
                                                          Command="{Binding PlacementTarget.DataContext.DeleteSelectedLoadCombinationsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Combination Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1"
                                                Grid.Column="2"
                                                VerticalAlignment="Top">
                                        <Button Content="Refresh List"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="{StaticResource Gap.Card}"
                                                Command="{Binding GetLoadCombinationsCommand}"/>
                                        <Button Content="Modify Matrix"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="{StaticResource Gap.Card}"
                                                Command="{Binding ModifyLoadCombinationsInMatrixViewCommand}"/>
                                        <Button Content="Export Matrix to Excel"
                                                Command="{Binding ExportLoadCombinationMatrixToExcelCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Analysis Results">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="{StaticResource Inset.Small}">
                                    <TextBlock Text="{Binding ActiveAnalysisResultsGroup}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               Margin="{StaticResource Gap.Section}"/>
                                    <Border Style="{StaticResource CompactCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="ETABS Tables"
                                                       Style="{StaticResource SectionHeadingTextStyle}"
                                                       Margin="{StaticResource Gap.Section}"/>
                                            <ItemsControl ItemsSource="{Binding AnalysisResultTables}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}"
                                                                Command="{Binding DataContext.ExportAnalysisResultTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Converter={StaticResource TableHeaderToolTipConverter}}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Margin="{StaticResource Gap.Card}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Section Property - Stiffness Modifier">
                            <TabControl Margin="{StaticResource Inset.Small}">
                                <TabItem Header="Frame Object">
                                    <Grid Margin="{StaticResource Inset.Small}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource CompactCardBorderStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="Frame Sections"
                                                           Style="{StaticResource SectionHeadingTextStyle}"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <TextBox Grid.Row="1"
                                                         Text="{Binding FrameSectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Margin="{StaticResource Gap.Card}"/>
                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal"
                                                            Margin="{StaticResource Gap.Card}">
                                                    <Button Content="Select Visible"
                                                            Style="{StaticResource SmallButtonStyle}"
                                                            Margin="{StaticResource Gap.Right}"
                                                            Command="{Binding SelectVisibleFrameStiffnessSectionsCommand}"/>
                                                    <Button Content="Clear"
                                                            Style="{StaticResource SmallButtonStyle}"
                                                            Command="{Binding ClearFrameStiffnessSectionSelectionCommand}"/>
                                                </StackPanel>
                                                <ListBox Grid.Row="3"
                                                         ItemsSource="{Binding FrameStiffnessSectionView}"
                                                         BorderBrush="{StaticResource BorderBrush.Light}"
                                                         BorderThickness="1"
                                                         SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Content="{Binding Name}"
                                                                      Margin="4,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Grid.Row="4"
                                                        Content="Refresh Sections"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Command="{Binding RefreshFrameStiffnessSectionsCommand}"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource CompactCardBorderStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="Frame Modifiers"
                                                           Style="{StaticResource SectionHeadingTextStyle}"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <ItemsControl Grid.Row="1"
                                                              ItemsSource="{Binding FrameModifierFields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="{StaticResource Gap.Row}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="82"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           Style="{StaticResource LabelTextStyle}"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         HorizontalContentAlignment="Right"
                                                                         Margin="6,0,0,0"
                                                                         Height="26"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding FrameModifierWarningText}"
                                                           Visibility="{Binding FrameModifierWarningVisibility}"
                                                           Foreground="{StaticResource AccentBrush.Warning}"
                                                           TextWrapping="Wrap"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <StackPanel Grid.Row="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0">
                                                    <Button Content="Apply"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Margin="{StaticResource Gap.Right}"
                                                            Command="{Binding ApplyFrameStiffnessModifiersCommand}"/>
                                                    <Button Content="Reset to Default"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding ResetFrameStiffnessModifiersCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Area Object">
                                    <Grid Margin="{StaticResource Inset.Small}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource CompactCardBorderStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="Area Sections"
                                                           Style="{StaticResource SectionHeadingTextStyle}"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <TextBox Grid.Row="1"
                                                         Text="{Binding AreaSectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="28"
                                                         Margin="{StaticResource Gap.Card}"/>
                                                <StackPanel Grid.Row="2"
                                                            Orientation="Horizontal"
                                                            Margin="{StaticResource Gap.Card}">
                                                    <Button Content="Select Visible"
                                                            Style="{StaticResource SmallButtonStyle}"
                                                            Margin="{StaticResource Gap.Right}"
                                                            Command="{Binding SelectVisibleAreaStiffnessSectionsCommand}"/>
                                                    <Button Content="Clear"
                                                            Style="{StaticResource SmallButtonStyle}"
                                                            Command="{Binding ClearAreaStiffnessSectionSelectionCommand}"/>
                                                </StackPanel>
                                                <ListBox Grid.Row="3"
                                                         ItemsSource="{Binding AreaStiffnessSectionView}"
                                                         BorderBrush="{StaticResource BorderBrush.Light}"
                                                         BorderThickness="1"
                                                         SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Content="{Binding Name}"
                                                                      Margin="4,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button Grid.Row="4"
                                                        Content="Refresh Sections"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Command="{Binding RefreshAreaStiffnessSectionsCommand}"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource CompactCardBorderStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Text="Area Modifiers"
                                                           Style="{StaticResource SectionHeadingTextStyle}"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <ItemsControl Grid.Row="1"
                                                              ItemsSource="{Binding AreaModifierFields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="{StaticResource Gap.Row}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="82"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           Style="{StaticResource LabelTextStyle}"/>
                                                                <TextBox Grid.Column="1"
                                                                         Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         HorizontalContentAlignment="Right"
                                                                         Margin="6,0,0,0"
                                                                         Height="26"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding AreaModifierWarningText}"
                                                           Visibility="{Binding AreaModifierWarningVisibility}"
                                                           Foreground="{StaticResource AccentBrush.Warning}"
                                                           TextWrapping="Wrap"
                                                           Margin="{StaticResource Gap.Card}"/>
                                                <StackPanel Grid.Row="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0">
                                                    <Button Content="Apply"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Margin="{StaticResource Gap.Right}"
                                                            Command="{Binding ApplyAreaStiffnessModifiersCommand}"/>
                                                    <Button Content="Reset to Default"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding ResetAreaStiffnessModifiersCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
