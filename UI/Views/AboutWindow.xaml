<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Excel CSI ToolBox" Height="340" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12.5" Foreground="#1F2937">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Banner -->
        <Border Grid.Row="0" Padding="20,24,20,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1F3A" Offset="0.0"/>
                    <GradientStop Color="#1E3A8A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Excel CSI ToolBox" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="VSTO Add-in for CSI ETABS &amp; SAP2000 Integration" FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body Details -->
        <StackPanel Grid.Row="1" Margin="24,18,24,18" VerticalAlignment="Top">
            <TextBlock Text="An advanced workflow integration add-in for Microsoft Excel, connecting with CSI ETABS &amp; SAP2000 models to perform automated post-processing and element connectivity manipulation." 
                       TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#475569" FontSize="12" LineHeight="17"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0.0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="aBui (buiquanganh1298@gmail.com)"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="License:" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT License"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="GitHub:" FontWeight="SemiBold" Foreground="#64748B"/>
                <TextBlock Grid.Row="3" Grid.Column="1">
                    <Hyperlink NavigateUri="https://github.com/Anhbq1298/ExcelCSIToolBoxAddIn" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#2563EB">
                        <TextBlock Text="github.com/Anhbq1298/ExcelCSIToolBoxAddIn"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!-- Footer / Action -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12,20,12">
            <Grid>
                <TextBlock Text="Copyright © 2026. All rights reserved." VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                <Button Content="Close" Width="80" Height="28" HorizontalAlignment="Right" Click="CloseButton_Click" IsCancel="True"
                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#1E293B" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
