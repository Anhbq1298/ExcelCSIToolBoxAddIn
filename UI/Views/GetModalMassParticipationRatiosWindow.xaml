<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.GetModalMassParticipationRatiosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modal Mass Participation Ratios"
        Height="520"
        Width="720"
        MinHeight="460"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Select ETABS modal load cases to extract Modal Mass Participation Ratios, then select the Excel anchor cell where output should start."
                   TextWrapping="Wrap"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1"
                  Header="ETABS Modal Load Cases"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Choose one or more modal load cases."
                               VerticalAlignment="Center"
                               Foreground="#444444"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ModalLoadCasesGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding ModalLoadCases}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"
                              SelectionChanged="ModalLoadCasesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding LoadCaseSelectionText}"
                               Foreground="#666666"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Header="Excel Anchor Cell"
                  Padding="8"
                  Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <RadioButton Content="Use active cell"
                                 IsChecked="{Binding IsUseActiveCellMode, Mode=TwoWay}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <RadioButton Content="Pick cell"
                                 IsChecked="{Binding IsPickCellMode, Mode=TwoWay}"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Anchor:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding AnchorCellAddress, Mode=OneWay}"
                         IsReadOnly="True"
                         Height="26"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding AnchorModeText}"
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontSize="11"
                           Margin="10,0,0,0"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <CheckBox Content="Add headers"
                          IsChecked="{Binding AddHeaders, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Run"
                        Click="RunButton_Click"
                        IsDefault="True"/>
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
