<Window x:Class="ExcelCSIToolBoxAddIn.UI.Views.ArrayBetweenTwoLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Array Between Two Lines"
        Width="620"
        Height="380"
        MinWidth="560"
        MinHeight="350"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource FontFamily.Primary}"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ExcelCSIToolBoxAddIn;component/UI/Themes/EtabsToolboxTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource Inset.Medium}">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"
                                      MinWidth="260"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Text="Array Between Two Lines"
                           Style="{StaticResource HeadingTextStyle}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Line 1"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding Line1Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Frame Unique Name"/>
                <Button Grid.Row="2"
                        Grid.Column="3"
                        Content="Pick"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding PickLine1Command}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Line 2"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding Line2Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Frame Unique Name"/>
                <Button Grid.Row="4"
                        Grid.Column="3"
                        Content="Pick"
                        Style="{StaticResource SmallButtonStyle}"
                        Command="{Binding PickLine2Command}"/>

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Assign Section"
                           Style="{StaticResource LabelTextStyle}"/>
                <ComboBox Grid.Row="6"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          ItemsSource="{Binding AvailableSections}"
                          SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                          Height="26"
                          VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="End Fixity"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Top"/>
                <StackPanel Grid.Row="8"
                            Grid.Column="1"
                            Grid.ColumnSpan="3">
                    <RadioButton Content="Fix-Fix"
                                 GroupName="LineEndFixity"
                                 IsChecked="{Binding IsFixFixSelected, Mode=TwoWay}"/>
                    <RadioButton Content="Pin-Pin"
                                 GroupName="LineEndFixity"
                                 Margin="0,5,0,0"
                                 IsChecked="{Binding IsPinPinSelected, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Text="Number of Spaces"
                           Style="{StaticResource LabelTextStyle}"/>
                <TextBox Grid.Row="10"
                         Grid.Column="1"
                         Width="70"
                         HorizontalAlignment="Left"
                         Text="{Binding NumberOfSpaces, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         HorizontalContentAlignment="Right"/>

                <TextBlock Grid.Row="12"
                           Grid.Column="0"
                           Text="Additional Options"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Top"/>
                <CheckBox Grid.Row="12"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Content="Include Start / End Connectors"
                          IsChecked="{Binding IncludeStartEndConnectors, Mode=TwoWay}"/>

                <StackPanel Grid.Row="14"
                            Grid.Column="0"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Create Frames"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="110"
                            Margin="{StaticResource Gap.Right}"
                            Command="{Binding CreateArrayBetweenTwoLinesFramesCommand}"/>
                    <Button Content="Close"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="76"
                            Command="{Binding CloseWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
